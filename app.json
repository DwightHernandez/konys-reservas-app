{
  "expo": {
    "name": "konys-reservas-app",
    "slug": "konys-reservas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/konys/konysLogo-app.png",
    "scheme": "konysreservasapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2B3D",
        "foregroundImage": "./assets/images/konys/konysLogo-app.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kedihm.konysreservasapp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2B3D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-system-ui",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d5925c2-6618-43e5-9e1f-79274fc950eb"
      }
    }
  }
}
